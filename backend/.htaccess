# brisko-api backend hardening.
#
# 1) Preserve the Authorization header. On many shared hosts PHP runs as
#    CGI/FastCGI and Apache drops this header, which would make the Firebase
#    ID-token auth used by the Cashfree endpoints fail with 401 even though the
#    app is signed in. REDIRECT_HTTP_AUTHORIZATION is read by auth_guard.php.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# 2) Never serve dotfiles (.env, .git, ...) or Composer metadata over HTTP.
<FilesMatch "(^\.|^composer\.(json|lock)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
