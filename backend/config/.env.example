# Brisko Pizza OTP backend — environment template.
# Copy to `.env` (same folder) and fill in real values. NEVER commit the .env
# file, the ApiTxt auth key or the Firebase service account JSON.

# --- ApiTxt (SMS OTP delivery) -------------------------------------------
# Private auth key. Server-side only — never ship it inside the Flutter app.
APITXT_AUTH_KEY=
APITXT_ENDPOINT=https://apitxt.com/api/sendOTP
APITXT_CHANNEL=sms
# Optional. Leave empty to use ApiTxt's default SMS OTP configuration.
APITXT_TEMPLATE_ID=
APITXT_TEMPLATE_NAME=
APITXT_COUNTRY=
APITXT_TIMEOUT=20

# --- Firebase Admin SDK ---------------------------------------------------
# Path to the service-account JSON stored OUTSIDE the public web root.
FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/brisko-secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
# Brisko uses uid = normalized phone (deliberate, see project spec).
FIREBASE_PHONE_AS_UID=true
# Optional: enables seeding the RTDB user record from PHP as well.
FIREBASE_DATABASE_URL=

# --- Cashfree Payment Gateway --------------------------------------------
# SERVER-SIDE ONLY. The client secret must never reach Flutter or Firebase.
# Get these from the Cashfree Merchant Dashboard (Developers > API keys).
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# SANDBOX while testing, PRODUCTION after go-live. Never mix the two.
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2025-01-01
CASHFREE_TIMEOUT=20
# Optional. Used as order_meta.return_url. Leave empty for the mobile SDK flow.
CASHFREE_RETURN_URL=
# Optional comma-separated allow-list. Defaults to INR.
CASHFREE_ALLOWED_CURRENCIES=INR

# --- Pricing (server-authoritative) --------------------------------------
# Keep in sync with the Flutter app (lib/core/constants/app_strings.dart).
BRISKO_GST_RATE=0.05
BRISKO_FREE_DELIVERY_THRESHOLD=499
BRISKO_FLAT_DELIVERY_FEE=40
BRISKO_MAX_ORDER_AMOUNT=50000

# --- OTP behaviour --------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30
OTP_RATE_PER_MINUTE=3
OTP_RATE_PER_HOUR=10

# --- Storage / logging / CORS --------------------------------------------
# Defaults live under backend/storage when unset.
OTP_STORAGE_PATH=
BRISKO_LOG_PATH=
# Only needed if a browser frontend calls this API. Comma-separated origins.
CORS_ALLOWED_ORIGINS=
# Keep false in production so no internals leak to clients.
APP_DEBUG=false
